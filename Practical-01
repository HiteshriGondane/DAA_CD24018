## 💻 C Program

```c
#include <stdio.h>

void quickSort(long long arr[], int low, int high)
{
    if (low < high)
    {
        int i = low;
        int j = high;
        long long pivot = arr[(low + high) / 2];

        while (i <= j)
        {
            while (arr[i] < pivot)
                i++;

            while (arr[j] > pivot)
                j--;

            if (i <= j)
            {
                long long temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;

                i++;
                j--;
            }
        }

        if (low < j)
            quickSort(arr, low, j);

        if (i < high)
            quickSort(arr, i, high);
    }
}

int main()
{
    int n;

    printf("Enter number of log entries: ");
    scanf("%d", &n);

    long long arr[n];

    printf("Enter Unix timestamps:\n");

    for (int i = 0; i < n; i++)
        scanf("%lld", &arr[i]);

    quickSort(arr, 0, n - 1);

    printf("\nChronologically sorted timestamps:\n");

    for (int i = 0; i < n; i++)
        printf("%lld ", arr[i]);

    return 0;
}
